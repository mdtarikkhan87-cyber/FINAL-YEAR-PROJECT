# --- data: large, public, re-downloadable, reproducible ---------------------
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/processed_decision/

# --- generated reports ------------------------------------------------------
reports/*
!reports/.gitkeep

# --- experiment tracking / models -------------------------------------------
mlruns/
mlartifacts/
mlflow.db
*.pkl
*.onnx

# Trained model bundles ARE committed (~3.9 MB total): the deployed backend
# loads them at startup and they are far too small to justify object storage.
# The native XGBoost exports are not -- they duplicate the bundles without the
# category levels and feature order the service needs, so nothing loads them.
src/models/artifacts/*_xgb.json
!src/models/artifacts/*_bundle.joblib
!src/models/artifacts/*_metadata.json

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- tooling ----------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- config / secrets -------------------------------------------------------
.env
.env.*
!.env.example

# --- editors / os -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- web frontend (Next.js) -------------------------------------------------
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/*.tsbuildinfo
web/.env.local

# --- tooling output (not project source) ------------------------------------
graphify-out/
