# --- Local development (npm run dev) ----------------------------------------
# When set, the BROWSER calls the API directly at this URL. Requires the API's
# CORS allowance (api/main.py already permits localhost:3000).
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# --- Containers / production -------------------------------------------------
# Leave NEXT_PUBLIC_API_BASE UNSET. The browser then calls the same-origin
# /api/* route and the Next server forwards to API_INTERNAL_URL, which is read
# at request time and so can be changed without rebuilding the image.
#
#   docker compose -> http://api:8000
#   deployed       -> https://your-api-host
#
# API_INTERNAL_URL=http://127.0.0.1:8000
